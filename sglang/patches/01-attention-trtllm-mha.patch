+    def _spec_verify_mask_row(self) -> torch.Tensor:
+        """Bit-packed causal draft mask for XQA, shape [1, q_seq_len, words].
+
+        Layout per flashinfer xqa: [bs, q_seq_len, ((q_seq_len + 31) // 32) * 2]
+        torch.uint16, little-endian bit i = draft position i is visible. Chain
+        speculation (topk == 1) is plain causal: row r admits positions 0..r.
+        """
+        cached = getattr(self, "_spec_verify_mask_row_cache", None)
+        if cached is not None:
+            return cached
+        spec_q = self.speculative_num_draft_tokens
+        # One uint32 word per 32 draft positions; xqa packs the row as uint16
+        # pairs "aligned with 32 bits", so the tensor exposed to the kernel is
+        # [q_seq_len, divUp(q_seq_len, 32) * 2] uint16 -- that is the same
+        # storage as [q_seq_len, divUp(q_seq_len, 32)] uint32, which is what we
+        # build here (bit i of word w = draft position 32*w + i is visible).
+        words = (spec_q + 31) // 32
+        row = torch.zeros(spec_q, words, dtype=torch.int32, device=self.device)
+        for r in range(spec_q):
+            for bit in range(r + 1):
+                row[r, bit // 32] |= 1 << (bit % 32)
+        cached = row.view(torch.uint16).unsqueeze(0)
+        self._spec_verify_mask_row_cache = cached
+        return cached
+
